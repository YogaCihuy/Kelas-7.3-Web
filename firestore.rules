rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // PENANDA VERSI: "hardening-v1-2026-11-25" — kalau di Rules Console
    // belum ada tulisan ini, berarti rules lama masih dipakai.

    // Data akun siswa: nama panggilan, bio, username/password login custom, role, dll.
    match /accounts/{absen} {
      allow read: if true;
      allow create, update: if isValidAccount(request.resource.data)
        && (!('absen' in request.resource.data) || string(request.resource.data.absen) == absen);
      allow delete: if false; // akun nggak pernah dihapus dari app, jadi diblok total
    }

    // Akun guru: biodata terpisah dari siswa (absen 33..64) + dipakai main Games.
    match /guru/{guruId} {
      allow read: if true;
      allow create, update: if guruId == string(request.resource.data.absen)
        && isValidGuru(request.resource.data);
      allow delete: if resource.data.role == 'guru'; // dipakai Admin/Owner lewat menu Atur Akun Guru
    }

    // Override jadwal/info harian (mapel, seragam, PR, dll) oleh admin
    match /infoOverrides/{tanggal} {
      allow read: if true;
      allow create, update: if isValidInfoOverride(request.resource.data);
      allow delete: if false;
    }

    // Album foto siswa (maks 3 foto, disimpan sebagai teks base64 yang udah dikecilin)
    match /albums/{absen} {
      allow read: if true;
      allow create, update: if isValidAlbum(request.resource.data);
      allow delete: if false; // hapus foto = slot dikosongin, dokumen gak dihapus
    }

    // Pengaturan umum (link medsos, dll)
    match /settings/{docId} {
      allow read: if true;
      allow create, update: if isValidSettings(request.resource.data);
      allow delete: if false;
    }

    // Key Gemini bersama supaya AI Chat jalan di semua siswa tanpa isi key.
    match /aiConfig/{docId} {
      allow read: if true;
      allow create, update: if isValidAiConfig(request.resource.data);
      allow delete: if false;
    }

    // Like biodata siswa di Home (satu dokumen per siswa, isi users = map absen)
    match /profilLikes/{absenSiswa} {
      allow read: if true;
      allow create, update: if isValidProfilLike(request.resource.data);
      allow delete: if false;
    }

    // Komentar biodata siswa di Home
    match /profilKomentar/{komentarId} {
      allow read: if true;
      allow create: if isValidKomentar(request.resource.data);
      allow update: if false;
      allow delete: if true;
    }

    // Polling kelas
    match /polling/{pollId} {
      allow read: if true;
      allow create, update: if isValidPolling(request.resource.data);
      allow delete: if true; // dipakai admin untuk hapus polling
    }

    // Data game per akun (Streak + Quiz)
    match /games/{absen} {
      allow read: if true;
      allow create, update: if isValidGame(request.resource.data);
      allow delete: if false;
    }

    // Tema & soal Quiz yang diatur Admin/Owner (dipakai semua akun)
    match /quizConfig/{docId} {
      allow read: if true;
      allow create, update: if isValidQuizConfig(request.resource.data);
      allow delete: if false;
    }

    // ── KISI KISI (kategori + materi PDF + hasil AI) ─────────
    // PDF disimpan per potongan base64 di kisiBerkas supaya tidak
    // kena batas 1 MB per dokumen, tanpa Storage/Blaze.
    match /kisiKategori/{kategoriId} {
      allow read: if true;
      allow create, update: if isValidKisiKategori(request.resource.data);
      allow delete: if true;
    }

    match /kisiMateri/{materiId} {
      allow read: if true;
      allow create, update: if isValidKisiMateri(request.resource.data);
      allow delete: if true;
    }

    match /kisiBerkas/{berkasId} {
      allow read: if true;
      allow create, update: if isValidKisiBerkas(request.resource.data);
      allow delete: if true;
    }

    // ── FISHING GAME (tanpa Blaze) ────────────────────────────
    // Ditulis langsung dari browser lewat transaksi Firestore. RNG & aturan
    // main ada di fishing-local.js, bentuk dokumen dijaga rules di bawah.
    // PENANDA VERSI: "fishing-v4-worker-potion-guru-2026-11-25" — kalau di Rules Console
    // tidak ada tulisan ini, berarti rules lama masih yang dipakai.
    match /fishing/{absen} {
      allow read: if true;
      allow create, update: if isValidFishingState(request.resource.data);
      allow delete: if false;
    }
    match /fishingCasts/{castId} {
      allow read, write: if false; // peninggalan versi server, sudah tidak dipakai
    }
    match /fishingSecrets/{absen} {
      allow read, write: if false; // peninggalan versi server, jangan pernah dibaca client
    }
    match /fishingMeta/{docId} {
      allow read: if true; // First Legend/Secret
      allow create, update: if isValidFirstCatches(request.resource.data);
      allow delete: if false;
    }
    match /fishingAnnouncements/{docId} {
      allow read: if true; // pengumuman global
      allow create: if isValidFishingAnnouncement(request.resource.data);
      allow update, delete: if false;
    }

    function isValidFishingState(d) {
      return d.keys().hasOnly(['absen','name','coins','rods','equippedRod','baits','equippedBait',
                                'potions','activePotions','fish','locked','collection','totalValue','totalCaught','stats',
                                'achievements','activeCast','requests','autoSell','workers',
                                'createdAt','updatedAt','version'])
        && d.keys().hasAll(['absen','name','coins','rods','equippedRod','baits','equippedBait',
                            'fish','locked','collection','totalValue','totalCaught','stats',
                            'achievements','createdAt','updatedAt'])
        && d.absen is number
        && d.absen >= 1
        && d.absen <= 64
        && d.name is string
        && d.name.size() <= 60
        && d.coins is number
        && d.coins >= 0
        && d.coins <= 1000000000
        && d.rods is list
        && d.rods.size() >= 1
        && d.rods.size() <= 12
        && d.equippedRod is string
        && d.baits is map
        && d.equippedBait is string
        && (!('potions' in d) || (d.potions is map && d.potions.size() <= 64))
        && (!('activePotions' in d) || isValidActivePotions(d.activePotions))
        && d.fish is map
        && d.locked is map
        && d.collection is map
        && d.totalValue is number
        && d.totalValue >= 0
        && d.totalCaught is number
        && d.totalCaught >= 0
        && d.stats is map
        && d.achievements is map
        && (!('activeCast' in d) || d.activeCast == null || d.activeCast is map)
        && (!('requests' in d) || (d.requests is list && d.requests.size() <= 12))
        && (!('autoSell' in d) || isValidAutoSell(d.autoSell))
        && (!('workers' in d) || isValidFishingWorkers(d.workers))
        && d.createdAt is number
        && d.updatedAt is number
        && (!('version' in d) || d.version is number);
    }

    function isValidAutoSell(a) {
      return a is map
        && a.keys().hasOnly(['enabled','minPrice'])
        && a.keys().hasAll(['enabled','minPrice'])
        && a.enabled is bool
        && a.minPrice is number
        && a.minPrice >= 0
        && a.minPrice <= 1000000;
    }

    function isValidFishingWorkers(list) {
      return list is list
        && list.size() <= 3
        && (list.size() < 1 || isValidFishingWorker(list[0]))
        && (list.size() < 2 || isValidFishingWorker(list[1]))
        && (list.size() < 3 || isValidFishingWorker(list[2]));
    }

    function isValidFishingWorker(w) {
      return w is map
        && w.keys().hasOnly(['id','name','gender','look','level','rodId','lastCatchAt','catches','earned','hiredAt'])
        && w.keys().hasAll(['id','name','gender','look','level','rodId','lastCatchAt','catches','earned','hiredAt'])
        && w.id is string
        && w.id.size() >= 1
        && w.id.size() <= 40
        && w.name is string
        && w.name.size() >= 1
        && w.name.size() <= 60
        && w.gender is string
        && w.gender in ['laki','perempuan','lainnya']
        && w.look is string
        && w.look in ['topi','kapten','anak','nenek','kakek','keren']
        && w.level is number
        && w.level >= 0
        && w.level <= 9
        && w.rodId is string
        && w.rodId.size() <= 40
        && w.lastCatchAt is number
        && w.catches is number
        && w.catches >= 0
        && w.earned is number
        && w.earned >= 0
        && w.hiredAt is number;
    }

    function isValidActivePotions(a) {
      return a is map
        && a.keys().hasOnly(['luck','worker','coin'])
        && (!('luck' in a) || (isValidActivePotion(a.luck) && a.luck.id.matches('^luck-[23]-(5|10|15|30)$')))
        && (!('worker' in a) || (isValidActivePotion(a.worker) && a.worker.id.matches('^worker-2-(5|10|15|30)$')))
        && (!('coin' in a) || (isValidActivePotion(a.coin) && a.coin.id.matches('^coin-2-(5|10|15|30)$')));
    }

    function isValidActivePotion(p) {
      return p is map
        && p.keys().hasOnly(['id','endsAt'])
        && p.keys().hasAll(['id','endsAt'])
        && p.id is string
        && p.endsAt is number
        && p.endsAt > 0;
    }

    function isValidFirstCatches(d) {
      return d.keys().hasOnly(['legend','secret'])
        && (!('legend' in d) || (d.legend is list && d.legend.size() <= 3))
        && (!('secret' in d) || (d.secret is list && d.secret.size() <= 3));
    }

    function isValidFishingAnnouncement(d) {
      return d.keys().hasOnly(['type','absen','name','fishId','fishName','firstSlot','at'])
        && d.keys().hasAll(['type','absen','name','fishId','fishName','firstSlot','at'])
        && d.type in ['legend','secret']
        && d.absen is number
        && d.absen >= 1
        && d.absen <= 64
        && d.name is string
        && d.name.size() <= 60
        && d.fishId is string
        && d.fishId.size() <= 40
        && d.fishName is string
        && d.fishName.size() <= 60
        && d.firstSlot is number
        && d.firstSlot >= 0
        && d.firstSlot <= 3
        && d.at is number;
    }

    // ── TABLEVERSE (tanpa server) ────────────────────────────
    // Ditulis langsung dari browser lewat transaksi Firestore. Validasi bentuk
    // dokumen tetap jalan di rules; validasi gerakan ada di tableverse-local.js.
    match /tvPlayers/{absen} {
      allow read: if true;
      allow create, update: if isValidTvPlayer(request.resource.data);
      allow delete: if false;
    }
    match /tvRooms/{roomId} {
      allow read: if true;
      allow create, update: if isValidTvRoom(request.resource.data);
      allow delete: if true;
    }
    match /tvInvites/{inviteId} {
      allow read: if true;
      allow create, update: if isValidTvInvite(request.resource.data);
      allow delete: if true;
    }
    match /tvHistory/{historyId} {
      allow read: if true;
      allow create: if isValidTvHistory(request.resource.data);
      allow update, delete: if false;
    }
    // Tidak dipakai lagi (UNO disembunyikan), tetap ditutup total.
    match /tvHidden/{docId} {
      allow read, write: if false;
    }

    // ── GUESS THE COLOR (duel 1v1 tanpa server) ──────────────
    // Ditulis langsung dari browser. Kode rahasia warna cuma disimpan di
    // localStorage masing-masing pemain dan baru ditulis ke room saat selesai.
    match /gcPlayers/{absen} {
      allow read: if true;
      allow create, update: if isValidGcPlayer(request.resource.data);
      allow delete: if true;
    }
    match /gcInvites/{inviteId} {
      allow read: if true;
      allow create, update: if isValidGcInvite(request.resource.data);
      allow delete: if true;
    }
    match /gcRooms/{roomId} {
      allow read: if true;
      allow create, update: if isValidGcRoom(request.resource.data);
      allow delete: if true;
      match /moves/{moveId} {
        allow read: if true;
        allow create, update: if isValidGcMove(request.resource.data);
        allow delete: if true;
      }
    }

    function isValidGcPlayer(d) {
      return d.keys().hasOnly(['nama','online','lastSeen','status'])
        && (!('nama' in d) || d.nama is string)
        && (!('online' in d) || d.online is bool)
        && (!('lastSeen' in d) || d.lastSeen is number)
        && (!('status' in d) || d.status is string);
    }

    function isValidGcInvite(d) {
      return d.keys().hasOnly(['fromAbsen','fromNama','toAbsen','toNama','roomId',
                                'createdAt','status','respondedAt'])
        && (!('roomId' in d) || d.roomId is string)
        && (!('createdAt' in d) || d.createdAt is number)
        && (!('respondedAt' in d) || d.respondedAt is number)
        && (!('status' in d) || d.status in ['pending','accepted','declined','expired']);
    }

    function isValidGcRoom(d) {
      return d.keys().hasOnly(['code','createdAt','updatedAt','lastActivity',
                                'hostAbsen','hostNama','guestAbsen','guestNama',
                                'status','hostReady','guestReady','hostSeen','guestSeen',
                                'startAt','endAt','winner','alasan','finishedAt',
                                'hostSecret','guestSecret','hostRematch','guestRematch'])
        && (!('status' in d) || d.status in ['lobby','setup','playing','finished'])
        && (!('winner' in d) || d.winner == null || d.winner in ['host','guest','draw'])
        && (!('hostSecret' in d) || d.hostSecret == null || (d.hostSecret is list && d.hostSecret.size() == 4))
        && (!('guestSecret' in d) || d.guestSecret == null || (d.guestSecret is list && d.guestSecret.size() == 4));
    }

    function isValidGcMove(d) {
      return d.keys().hasOnly(['n','by','colors','at','exact','partial','evaluatedAt','evaluatedBy'])
        && (!('n' in d) || d.n is number)
        && (!('by' in d) || d.by in ['host','guest'])
        && (!('colors' in d) || (d.colors is list && d.colors.size() == 4))
        && (!('exact' in d) || d.exact == null || (d.exact is number && d.exact >= 0 && d.exact <= 4))
        && (!('partial' in d) || d.partial == null || (d.partial is number && d.partial >= 0 && d.partial <= 4));
    }

    // ── BLOCK BLAST (puzzle tanpa server) ────────────────────
    // Ditulis langsung dari browser. Skor & combo dihitung di
    // blockblast.js; rules cuma menjaga bentuk dokumennya.
    match /blockblast/{absen} {
      allow read: if true;
      allow create, update: if isValidBlockBlast(request.resource.data);
      allow delete: if false;
    }

    function isValidBlockBlast(d) {
      return d.keys().hasOnly(['absen','name','bestScore','bestCombo','lines','games','createdAt','updatedAt'])
        && d.keys().hasAll(['absen','name','bestScore','bestCombo','lines','games','createdAt','updatedAt'])
        && d.absen is number
        && d.absen >= 1
        && d.absen <= 64
        && d.name is string
        && d.name.size() <= 60
        && d.bestScore is number
        && d.bestScore >= 0
        && d.bestScore <= 1000000000
        && d.bestCombo is number
        && d.bestCombo >= 0
        && d.bestCombo <= 10000
        && d.lines is number
        && d.lines >= 0
        && d.lines <= 1000000000
        && d.games is number
        && d.games >= 0
        && d.games <= 1000000000
        && d.createdAt is number
        && d.updatedAt is number;
    }

    // ── SUDOKU (puzzle tanpa server) ─────────────────────────
    // Poin menumpuk tiap soal selesai. Soal & pengecekan jawaban
    // di browser; rules cuma menjaga bentuk dokumennya.
    match /sudoku/{absen} {
      allow read: if true;
      allow create, update: if isValidSudoku(request.resource.data);
      allow delete: if false;
    }

    function isValidSudoku(d) {
      return d.keys().hasOnly(['absen','name','points','wins','games','createdAt','updatedAt'])
        && d.keys().hasAll(['absen','name','points','wins','games','createdAt','updatedAt'])
        && d.absen is number
        && d.absen >= 1
        && d.absen <= 64
        && d.name is string
        && d.name.size() <= 60
        && d.points is number
        && d.points >= 0
        && d.points <= 1000000000
        && d.wins is number
        && d.wins >= 0
        && d.wins <= 1000000
        && d.games is number
        && d.games >= 0
        && d.games <= 1000000
        && d.createdAt is number
        && d.updatedAt is number;
    }

    // ── RUBIK CUBE 3x3 (speedrun tanpa server) ───────────────
    // Satu dokumen per akun berisi rekor tercepat. Kubus dihitung
    // di browser; rules cuma menjaga bentuk dokumennya.
    match /rubik/{absen} {
      allow read: if true;
      allow create, update: if isValidRubik(request.resource.data);
      allow delete: if false;
    }

    function isValidRubik(d) {
      return d.keys().hasOnly(['absen','name','bestMs','bestMoves','solves','createdAt','updatedAt'])
        && d.keys().hasAll(['absen','name','bestMs','bestMoves','solves','createdAt','updatedAt'])
        && d.absen is number
        && d.absen >= 1
        && d.absen <= 64
        && d.name is string
        && d.name.size() <= 60
        && d.bestMs is number
        && d.bestMs >= 0
        && d.bestMs <= 86400000
        && d.bestMoves is number
        && d.bestMoves >= 0
        && d.bestMoves <= 100000
        && d.solves is number
        && d.solves >= 0
        && d.solves <= 1000000
        && d.createdAt is number
        && d.updatedAt is number;
    }

    // ── SURVIVAL ARENA ──────────────────────────────────────
    // Satu dokumen per akun: rekor bertahan, total kill, dan kosmetik
    // karakter. Gameplay jalan di browser, jadi rules yang mengawal:
    // bentuk data, batas wajar, dan rekor hanya boleh naik (monoton).
    match /survival/{absen} {
      allow read: if true;
      allow create: if string(request.resource.data.absen) == absen
        && isValidSurvival(request.resource.data);
      allow update: if string(request.resource.data.absen) == absen
        && isValidSurvival(request.resource.data)
        && request.resource.data.bestTime >= resource.data.bestTime
        && request.resource.data.bestKills >= resource.data.bestKills
        && request.resource.data.bestWave >= resource.data.bestWave
        && request.resource.data.bestLevel >= resource.data.bestLevel
        && request.resource.data.totalKills >= resource.data.totalKills
        && request.resource.data.games >= resource.data.games;
      allow delete: if false;
    }

    function isValidSurvival(d) {
      return d.keys().hasOnly(['absen','name','bestTime','bestKills','bestWave','bestLevel',
                               'totalKills','games','character','createdAt','updatedAt','version'])
        && d.keys().hasAll(['absen','name','bestTime','bestKills','bestWave','bestLevel',
                            'totalKills','games','character','createdAt','updatedAt','version'])
        && d.absen is number
        && d.absen >= 1
        && d.absen <= 64
        && d.name is string
        && d.name.size() >= 1
        && d.name.size() <= 30
        && d.bestTime is number
        && d.bestTime >= 0
        && d.bestTime <= 86400
        && d.bestKills is number
        && d.bestKills >= 0
        && d.bestKills <= 50000
        && d.bestWave is number
        && d.bestWave >= 0
        && d.bestWave <= 500
        && d.bestLevel is number
        && d.bestLevel >= 0
        && d.bestLevel <= 300
        && d.totalKills is number
        && d.totalKills >= 0
        && d.totalKills <= 10000000
        && d.totalKills >= d.bestKills
        && d.games is number
        && d.games >= 0
        && d.games <= 1000000
        && d.character is map
        && isValidSurvivalChar(d.character)
        && d.createdAt is number
        && d.createdAt > 0
        && d.updatedAt is number
        && d.updatedAt > 0
        && d.version == 1;
    }

    function isValidSurvivalChar(c) {
      return c.keys().hasOnly(['hair','face','outfit','color','acc','skin'])
        && c.keys().hasAll(['hair','face','outfit','color','acc','skin'])
        && c.hair in ['pendek','spiky','jabrik','botak']
        && c.face in ['biasa','serius','senyum','mata-satu']
        && c.outfit in ['kaos','jaket','lab','rompi']
        && c.color in ['hijau','biru','merah','ungu','kuning']
        && c.acc in ['none','topi','kacamata','masker']
        && c.skin in ['terang','sawo','gelap'];
    }

    // ── HAUNTED DORM ─────────────────────────────────────────
    // Rekor per akun (satu dokumen per absen) dan room mabar beserta
    // dokumen pemainnya. Simulasi jalan di browser, jadi rules menjaga
    // bentuk data, batas wajar, dan rekor cuma boleh naik.
    match /haunted/{absen} {
      allow read: if true;
      allow create: if string(request.resource.data.absen) == absen
        && isValidHauntedRecord(request.resource.data);
      allow update: if string(request.resource.data.absen) == absen
        && isValidHauntedRecord(request.resource.data)
        && request.resource.data.bestTime >= resource.data.bestTime
        && request.resource.data.wins >= resource.data.wins
        && request.resource.data.games >= resource.data.games
        && request.resource.data.bestGold >= resource.data.bestGold
        && request.resource.data.totalGold >= resource.data.totalGold
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    function isValidHauntedRecord(d) {
      return d.keys().hasOnly(['absen','name','bestTime','wins','games','bestGold',
                               'totalGold','createdAt','updatedAt','version'])
        && d.keys().hasAll(['absen','name','bestTime','wins','games','bestGold',
                            'totalGold','createdAt','updatedAt','version'])
        && d.absen is number
        && d.absen >= 1
        && d.absen <= 64
        && d.name is string
        && d.name.size() >= 1
        && d.name.size() <= 30
        && d.bestTime is number
        && d.bestTime >= 0
        && d.bestTime <= 180
        && d.wins is number
        && d.wins >= 0
        && d.wins <= 1000000
        && d.games is number
        && d.games >= 0
        && d.games <= 1000000
        && d.wins <= d.games
        && d.bestGold is number
        && d.bestGold >= 0
        && d.bestGold <= 100000
        && d.totalGold is number
        && d.totalGold >= 0
        && d.totalGold <= 100000000
        && d.totalGold >= d.bestGold
        && d.createdAt is number
        && d.createdAt > 0
        && d.updatedAt is number
        && d.updatedAt > 0
        && d.version == 1;
    }

    match /hauntedRooms/{kode} {
      allow read: if true;
      allow create: if kode.matches('^[A-Z2-9]{5}$')
        && request.resource.data.code == kode
        && isValidHauntedRoom(request.resource.data);
      allow update: if kode.matches('^[A-Z2-9]{5}$')
        && request.resource.data.code == kode
        && isValidHauntedRoom(request.resource.data);
      allow delete: if kode.matches('^[A-Z2-9]{5}$');
    }

    match /hauntedRooms/{kode}/players/{absen} {
      allow read: if true;
      allow create: if kode.matches('^[A-Z2-9]{5}$')
        && string(request.resource.data.absen) == absen
        && isValidHauntedPlayer(request.resource.data);
      allow update: if kode.matches('^[A-Z2-9]{5}$')
        && string(request.resource.data.absen) == absen
        && isValidHauntedPlayer(request.resource.data);
      allow delete: if kode.matches('^[A-Z2-9]{5}$')
        && string(resource.data.absen) == absen;
    }

    function isValidHauntedRoom(d) {
      return d.keys().hasOnly(['code','hostAbsen','hostName','status','seed','startAt',
                               'kapasitas','createdAt','updatedAt','version'])
        && d.keys().hasAll(['code','hostAbsen','hostName','status','seed','startAt',
                            'kapasitas','createdAt','updatedAt','version'])
        && d.code is string
        && d.code.size() == 5
        && d.hostAbsen is number
        && d.hostAbsen >= 1
        && d.hostAbsen <= 64
        && d.hostName is string
        && d.hostName.size() >= 1
        && d.hostName.size() <= 30
        && d.status in ['lobby','playing']
        && d.seed is number
        && d.seed >= 0
        && d.seed <= 1000000000
        && d.startAt is number
        && d.startAt >= 0
        && d.kapasitas == 8
        && d.createdAt is number
        && d.createdAt > 0
        && d.updatedAt is number
        && d.updatedAt > 0
        && d.version == 1;
    }

    function isValidHauntedPlayer(d) {
      return d.keys().hasOnly(['absen','name','slot','alive','hp','doorHp','doorLv',
                               'bedLv','turrets','status','joinedAt','updatedAt','version'])
        && d.keys().hasAll(['absen','name','slot','alive','hp','doorHp','doorLv',
                            'bedLv','turrets','status','joinedAt','updatedAt','version'])
        && d.absen is number
        && d.absen >= 1
        && d.absen <= 64
        && d.name is string
        && d.name.size() >= 1
        && d.name.size() <= 30
        && d.slot is number
        && d.slot >= 0
        && d.slot <= 7
        && d.alive is bool
        && d.hp is number
        && d.hp >= 0
        && d.hp <= 100
        && d.doorHp is number
        && d.doorHp >= 0
        && d.doorHp <= (d.doorLv == 1 ? 160 : (d.doorLv == 2 ? 280 : 430))
        && d.doorLv is number
        && d.doorLv >= 1
        && d.doorLv <= 3
        && d.bedLv is number
        && d.bedLv >= 1
        && d.bedLv <= 3
        && d.turrets is string
        && d.turrets.size() <= 48
        && d.turrets.matches('^$|^[0-9]{1,2}:[0-9]{1,2}:[0-9](,[0-9]{1,2}:[0-9]{1,2}:[0-9]){0,3}$')
        && d.status in ['siap','aman','tidur','diserang','gugur']
        && d.joinedAt is number
        && d.joinedAt > 0
        && d.updatedAt is number
        && d.updatedAt > 0
        && d.version == 1;
    }

    // ── PROFIL GAME (nama, avatar, motto) ────────────────────
    // Satu dokumen per akun, dipakai TableVerse, Streak, Quiz,
    // Block Blast, dan Sudoku sebagai nama tampilan.
    match /gameProfiles/{absen} {
      allow read: if true;
      allow create, update: if isValidGameProfile(request.resource.data);
      allow delete: if false;
    }

    function isValidGameProfile(d) {
      return d.keys().hasOnly(['absen','nama','avatar','motto','foto','updatedAt'])
        && d.keys().hasAll(['absen','nama','updatedAt'])
        && d.absen is number
        && d.absen >= 1
        && d.absen <= 64
        && d.nama is string
        && d.nama.size() >= 1
        && d.nama.size() <= 20
        && (!('avatar' in d) || (d.avatar is string && d.avatar.size() <= 8))
        && (!('motto' in d) || (d.motto is string && d.motto.size() <= 40))
        && (!('foto' in d) || (d.foto is string && d.foto.size() <= 80000
            && (d.foto.size() == 0 || d.foto.matches('^data:image/(jpeg|png|webp);base64,.*'))))
        && d.updatedAt is timestamp;
    }

    // ── CHAT PRIVAT 1-ON-1 ───────────────────────────────────
    // Tanpa Firebase Auth, privasi dijaga di level UI (chat cuma
    // dibuka buat dua peserta) dan rules cuma menjaga bentuk dokumen.
    match /chatThreads/{threadId} {
      allow read: if true;
      allow create, update: if isValidChatThread(request.resource.data, threadId);
      allow delete: if false;
    }

    match /chatMessages/{pesanId} {
      allow read: if true;
      allow create: if isValidChatMessage(request.resource.data);
      allow update, delete: if false;
    }

    function isValidChatThread(d, threadId) {
      return d.keys().hasOnly(['id','peserta','lastText','lastAt','lastFrom','unread','updatedAt'])
        && d.keys().hasAll(['id','peserta','unread'])
        && d.id is string
        && d.id == threadId
        && d.peserta is list
        && d.peserta.size() == 2
        && d.peserta[0] is number
        && d.peserta[1] is number
        && d.peserta[0] >= 1
        && d.peserta[1] <= 64
        && d.peserta[0] < d.peserta[1]
        && d.unread is map
        && (!('lastText' in d) || (d.lastText is string && d.lastText.size() <= 120))
        && (!('lastAt' in d) || d.lastAt is number)
        && (!('lastFrom' in d) || (d.lastFrom is number && d.lastFrom >= 1 && d.lastFrom <= 64))
        && (!('updatedAt' in d) || d.updatedAt is number);
    }

    function isValidChatMessage(d) {
      return d.keys().hasOnly(['threadId','from','to','nama','teks','at'])
        && d.keys().hasAll(['threadId','from','to','teks','at'])
        && d.threadId is string
        && d.threadId.size() >= 5
        && d.threadId.size() <= 12
        && d.from is number
        && d.from >= 1
        && d.from <= 64
        && d.to is number
        && d.to >= 1
        && d.to <= 64
        && d.from != d.to
        && (!('nama' in d) || (d.nama is string && d.nama.size() <= 60))
        && d.teks is string
        && d.teks.size() >= 1
        && d.teks.size() <= 500
        && d.at is number;
    }

    function isValidProfilLike(d) {
      return d.keys().hasOnly(['users','count','updatedAt'])
        && (!('users' in d) || d.users is map)
        && (!('count' in d) || (d.count is number && d.count >= 0 && d.count <= 100))
        && (!('updatedAt' in d) || d.updatedAt is number);
    }

    function isValidKomentar(d) {
      return d.keys().hasOnly(['absenSiswa','absen','nama','pesan','createdAt','balasKe','balasNama'])
        && d.keys().hasAll(['absenSiswa','absen','nama','pesan','createdAt'])
        && d.absenSiswa is number
        && d.absenSiswa >= 1
        && d.absenSiswa <= 64
        && d.absen is number
        && d.absen >= 1
        && d.absen <= 64
        && d.nama is string
        && d.nama.size() <= 60
        && d.pesan is string
        && d.pesan.size() > 0
        && d.pesan.size() <= 280
        && d.createdAt is number
        && (!('balasKe' in d) || (d.balasKe is string && d.balasKe.size() > 0 && d.balasKe.size() <= 40))
        && (!('balasNama' in d) || (d.balasNama is string && d.balasNama.size() <= 60));
    }

    function isValidTvPlayer(d) {
      return d.keys().hasOnly(['absen','nama','username','stats','lastSeen','roomId','roomStatus','createdAt','lastMatchAt'])
        && d.keys().hasAll(['absen','nama'])
        && d.absen is number
        && d.nama is string
        && d.nama.size() <= 60
        && (!('username' in d) || (d.username is string && d.username.size() <= 60))
        && (!('stats' in d) || d.stats == null || d.stats is map)
        && (!('lastSeen' in d) || d.lastSeen is number)
        && (!('roomId' in d) || d.roomId == null || (d.roomId is string && d.roomId.size() <= 24))
        && (!('roomStatus' in d) || d.roomStatus == null || d.roomStatus in ['waiting','playing','finished'])
        && (!('createdAt' in d) || d.createdAt is number || d.createdAt is timestamp)
        && (!('lastMatchAt' in d) || d.lastMatchAt is number);
    }

    function isValidTvRoom(d) {
      return d.keys().hasOnly(['id','gameId','gameTitle','mode','visibility','code','hostAbsen','players',
                                'minPlayers','maxPlayers','status','state','seq','turnSlot','handVersions',
                                'winnerSlots','draw','result','historyId','createdAt','startedAt','finishedAt',
                                'lastActivity','lastEvent'])
        && d.keys().hasAll(['id','gameId','hostAbsen','players','status','seq'])
        && d.id is string
        && d.id.size() <= 24
        && d.gameId in ['ttt','checkers','chess','ludo','snakes','stick']
        && d.hostAbsen is number
        && d.players is list
        && d.players.size() >= 1
        && d.players.size() <= 4
        && d.status in ['lobby','playing','finished']
        && d.seq is number
        && d.seq >= 0
        && (!('gameTitle' in d) || (d.gameTitle is string && d.gameTitle.size() <= 40))
        && (!('mode' in d) || d.mode in ['duel','party'])
        && (!('visibility' in d) || d.visibility in ['public','private'])
        && (!('code' in d) || (d.code is string && d.code.size() <= 24))
        && (!('minPlayers' in d) || (d.minPlayers is number && d.minPlayers >= 2 && d.minPlayers <= 4))
        && (!('maxPlayers' in d) || (d.maxPlayers is number && d.maxPlayers >= 2 && d.maxPlayers <= 4))
        && (!('state' in d) || d.state == null || d.state is map)
        && (!('turnSlot' in d) || d.turnSlot == null || (d.turnSlot is number && d.turnSlot >= 0 && d.turnSlot <= 3))
        && (!('handVersions' in d) || d.handVersions is map)
        && (!('winnerSlots' in d) || d.winnerSlots is list)
        && (!('draw' in d) || d.draw is bool)
        && (!('result' in d) || d.result == null || d.result is map)
        && (!('historyId' in d) || d.historyId == null || d.historyId is string)
        && (!('createdAt' in d) || d.createdAt is number)
        && (!('startedAt' in d) || d.startedAt == null || d.startedAt is number)
        && (!('finishedAt' in d) || d.finishedAt == null || d.finishedAt is number)
        && (!('lastActivity' in d) || d.lastActivity is number)
        && (!('lastEvent' in d) || (d.lastEvent is string && d.lastEvent.size() <= 300));
    }

    function isValidTvInvite(d) {
      return d.keys().hasOnly(['id','roomId','fromAbsen','fromNama','toAbsen','toNama','gameId','mode',
                                'status','createdAt','expiresAt','respondedAt'])
        && d.keys().hasAll(['id','roomId','fromAbsen','toAbsen','gameId','status'])
        && d.id is string
        && d.id.size() <= 200
        && d.roomId is string
        && d.roomId.size() <= 24
        && d.fromAbsen is number
        && d.toAbsen is number
        && d.gameId in ['ttt','checkers','chess','ludo','snakes','stick']
        && d.status in ['pending','accepted','declined','expired']
        && (!('fromNama' in d) || (d.fromNama is string && d.fromNama.size() <= 60))
        && (!('toNama' in d) || (d.toNama is string && d.toNama.size() <= 60))
        && (!('mode' in d) || d.mode in ['duel','party'])
        && (!('createdAt' in d) || d.createdAt is number)
        && (!('expiresAt' in d) || d.expiresAt is number)
        && (!('respondedAt' in d) || d.respondedAt == null || d.respondedAt is number);
    }

    function isValidTvHistory(d) {
      return d.keys().hasOnly(['roomId','gameId','gameTitle','mode','playerAbsens','players','winnerAbsens',
                                'winnerNama','draw','durationMs','startedAt','finishedAt'])
        && d.keys().hasAll(['roomId','gameId','playerAbsens','finishedAt'])
        && d.roomId is string
        && d.gameId in ['ttt','checkers','chess','ludo','snakes','stick']
        && d.playerAbsens is list
        && d.playerAbsens.size() >= 1
        && d.playerAbsens.size() <= 4
        && d.finishedAt is number
        && (!('gameTitle' in d) || d.gameTitle is string)
        && (!('mode' in d) || d.mode in ['duel','party'])
        && (!('players' in d) || d.players is list)
        && (!('winnerAbsens' in d) || d.winnerAbsens is list)
        && (!('winnerNama' in d) || d.winnerNama is list)
        && (!('draw' in d) || d.draw is bool)
        && (!('durationMs' in d) || d.durationMs is number)
        && (!('startedAt' in d) || d.startedAt == null || d.startedAt is number);
    }

    function isValidAccount(d) {
      let allowedKeys = ['absen','namaLengkap','namaPanggilan','citaCita','laguFavorit',
                          'bio','username','password','role','eskulWajib','eskulPilihan','notifEskul',
                          'ultah'];
      return d.keys().hasOnly(allowedKeys)
        && (!('absen' in d) || (d.absen is int && d.absen >= 1 && d.absen <= 64))
        && (!('role' in d) || d.role in ['member','admin','owner'])
        && (!('eskulPilihan' in d) || (d.eskulPilihan is list && d.eskulPilihan.size() <= 10))
        && (!('eskulWajib' in d) || (d.eskulWajib is string && d.eskulWajib.size() <= 40))
        && (!('notifEskul' in d) || d.notifEskul is bool)
        && (!('namaPanggilan' in d) || (d.namaPanggilan is string && d.namaPanggilan.size() <= 60))
        && (!('citaCita' in d) || (d.citaCita is string && d.citaCita.size() <= 120))
        && (!('laguFavorit' in d) || (d.laguFavorit is string && d.laguFavorit.size() <= 120))
        && (!('bio' in d) || (d.bio is string && d.bio.size() <= 800))
        && (!('username' in d) || (d.username is string && d.username.size() <= 40))
        && (!('password' in d) || (d.password is string && d.password.size() <= 80))
        && (!('ultah' in d) || (d.ultah is string
            && (d.ultah == '' || d.ultah.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))));
    }

    function isValidGuru(d) {
      let allowedKeys = ['absen','namaLengkap','namaPanggilan','mapel','bio','ultah',
                          'username','password','role','createdAt','updatedAt'];
      return d.keys().hasOnly(allowedKeys)
        && d.keys().hasAll(['absen','namaLengkap','namaPanggilan','username','password','role'])
        && d.absen is number
        && d.absen is int
        && d.absen >= 33
        && d.absen <= 64
        && d.role == 'guru'
        && d.namaLengkap is string
        && d.namaLengkap.size() >= 1
        && d.namaLengkap.size() <= 80
        && d.namaPanggilan is string
        && d.namaPanggilan.size() >= 1
        && d.namaPanggilan.size() <= 40
        && d.username is string
        && d.username.size() >= 1
        && d.username.size() <= 40
        && d.password is string
        && d.password.size() >= 1
        && d.password.size() <= 80
        && (!('mapel' in d) || (d.mapel is string && d.mapel.size() <= 80))
        && (!('bio' in d) || (d.bio is string && d.bio.size() <= 300))
        && (!('ultah' in d) || (d.ultah is string
            && (d.ultah == '' || d.ultah.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))))
        && (!('createdAt' in d) || d.createdAt is number)
        && (!('updatedAt' in d) || d.updatedAt is number);
    }

    function isValidInfoOverride(d) {
      let allowedKeys = ['mapelOverride','seragamOverride','pr','eskulLiburList','catatan',
                          'kegiatan','editedBy','editedAt',
                          'piketOverride','piketSelesai','piketEditedBy','piketEditedAt'];
      return d.keys().hasOnly(allowedKeys)
        && (!('mapelOverride' in d) || (d.mapelOverride is string && d.mapelOverride.size() <= 300))
        && (!('seragamOverride' in d) || (d.seragamOverride is string && d.seragamOverride.size() <= 200))
        && (!('pr' in d) || (d.pr is string && d.pr.size() <= 400))
        && (!('catatan' in d) || (d.catatan is string && d.catatan.size() <= 400))
        && (!('eskulLiburList' in d) || (d.eskulLiburList is list && d.eskulLiburList.size() <= 10))
        && (!('kegiatan' in d) || (d.kegiatan is string && d.kegiatan.size() <= 300))
        && (!('editedBy' in d) || (d.editedBy is string && d.editedBy.size() <= 60))
        && (!('editedAt' in d) || d.editedAt is timestamp)
        && (!('piketOverride' in d) || (d.piketOverride is list && d.piketOverride.size() <= 12))
        && (!('piketSelesai' in d) || (d.piketSelesai is list && d.piketSelesai.size() <= 64))
        && (!('piketEditedBy' in d) || (d.piketEditedBy is string && d.piketEditedBy.size() <= 60))
        && (!('piketEditedAt' in d) || d.piketEditedAt is timestamp);
    }

    function isValidAlbum(d) {
      let allowedKeys = ['f1','f2','f3','updatedAt'];
      let pola = '^data:image/(jpeg|png|webp);base64,.*';
      return d.keys().hasOnly(allowedKeys)
        && (!('f1' in d) || (d.f1 is string && d.f1.size() < 300000 && d.f1.matches(pola)))
        && (!('f2' in d) || (d.f2 is string && d.f2.size() < 300000 && d.f2.matches(pola)))
        && (!('f3' in d) || (d.f3 is string && d.f3.size() < 300000 && d.f3.matches(pola)))
        && (!('updatedAt' in d) || d.updatedAt is timestamp);
    }

    function isValidSettings(d) {
      let allowedKeys = ['tiktok','ig'];
      return d.keys().hasOnly(allowedKeys)
        && (!('tiktok' in d) || (d.tiktok is string
            && d.tiktok.size() <= 60
            && d.tiktok.matches('^[A-Za-z0-9._]*$')))
        && (!('ig' in d) || (d.ig is string
            && d.ig.size() <= 60
            && d.ig.matches('^[A-Za-z0-9._]*$')));
    }

    function isValidAiConfig(d) {
      return d.keys().hasOnly(['geminiKey','geminiModel','updatedAt','updatedBy'])
        && d.keys().hasAll(['geminiKey','geminiModel','updatedAt','updatedBy'])
        && d.geminiKey is string
        && d.geminiKey.size() <= 300
        && d.geminiModel is string
        && d.geminiModel.size() <= 80
        && d.updatedAt is number
        && d.updatedAt > 0
        && d.updatedBy is number
        && d.updatedBy >= 1
        && d.updatedBy <= 64;
    }

    function opsiItemSah(opsi, idx) {
      return idx >= opsi.size()
        || (opsi[idx] is string && opsi[idx].size() >= 1 && opsi[idx].size() <= 120);
    }

    function isValidPolling(d) {
      let allowedKeys = ['pertanyaan','opsi','maxPilihan','votes','dibuatOleh','dibuatOlehAbsen','createdAt'];
      return d.keys().hasOnly(allowedKeys)
        && d.keys().hasAll(allowedKeys)
        && d.pertanyaan is string
        && d.pertanyaan.size() >= 1
        && d.pertanyaan.size() <= 200
        && d.opsi is list
        && d.opsi.size() >= 2
        && d.opsi.size() <= 20
        && opsiItemSah(d.opsi, 0)
        && opsiItemSah(d.opsi, 1)
        && opsiItemSah(d.opsi, 2)
        && opsiItemSah(d.opsi, 3)
        && opsiItemSah(d.opsi, 4)
        && opsiItemSah(d.opsi, 5)
        && opsiItemSah(d.opsi, 6)
        && opsiItemSah(d.opsi, 7)
        && opsiItemSah(d.opsi, 8)
        && opsiItemSah(d.opsi, 9)
        && opsiItemSah(d.opsi, 10)
        && opsiItemSah(d.opsi, 11)
        && opsiItemSah(d.opsi, 12)
        && opsiItemSah(d.opsi, 13)
        && opsiItemSah(d.opsi, 14)
        && opsiItemSah(d.opsi, 15)
        && opsiItemSah(d.opsi, 16)
        && opsiItemSah(d.opsi, 17)
        && opsiItemSah(d.opsi, 18)
        && opsiItemSah(d.opsi, 19)
        && (d.maxPilihan == 'semua'
            || (d.maxPilihan is int && d.maxPilihan >= 1 && d.maxPilihan <= 20))
        && d.votes is map
        && d.votes.keys().size() <= 64
        && d.dibuatOleh is string
        && d.dibuatOleh.size() <= 60
        && d.dibuatOlehAbsen is int
        && d.dibuatOlehAbsen >= 1
        && d.dibuatOlehAbsen <= 64
        && (d.createdAt is timestamp || (d.createdAt is int && d.createdAt > 0));
    }

    function isValidGame(d) {
      let streakKeys = ['koin','pohon','hewan','diperbarui'];
      let quizKeys = ['benar','total','sesi','poin','poinMapel','seen','stat','statMapel','diperbarui'];
      return d.keys().hasOnly(['streak','quiz'])
        && (!('streak' in d) || (
          d.streak is map
          && d.streak.keys().hasOnly(streakKeys)
          && (!('koin' in d.streak) || d.streak.koin is number)
          && (!('diperbarui' in d.streak) || d.streak.diperbarui is number)
          && (!('pohon' in d.streak) || d.streak.pohon is map)
          && (!('hewan' in d.streak) || d.streak.hewan is map)
        ))
        && (!('quiz' in d) || (
          d.quiz is map
          && d.quiz.keys().hasOnly(quizKeys)
          && (!('benar' in d.quiz) || d.quiz.benar is number)
          && (!('total' in d.quiz) || d.quiz.total is number)
          && (!('sesi' in d.quiz) || d.quiz.sesi is number)
          && (!('poin' in d.quiz) || (d.quiz.poin is number && d.quiz.poin >= 0))
          && (!('poinMapel' in d.quiz) || d.quiz.poinMapel is map)
          && (!('statMapel' in d.quiz) || d.quiz.statMapel is map)
          && (!('diperbarui' in d.quiz) || d.quiz.diperbarui is number)
          && (!('seen' in d.quiz) || d.quiz.seen is map)
          && (!('stat' in d.quiz) || d.quiz.stat is map)
        ));
    }

    function isValidKisiKategori(d) {
      return d.keys().hasOnly(['nama','urutan','dibuatOleh','createdAt'])
        && d.keys().hasAll(['nama','urutan','dibuatOleh','createdAt'])
        && d.nama is string
        && d.nama.size() >= 1
        && d.nama.size() <= 80
        && d.urutan is number
        && d.urutan >= 0
        && d.urutan <= 100000
        && d.dibuatOleh == 29
        && d.createdAt is number;
    }

    function isValidKisiMateri(d) {
      return d.keys().hasOnly(['kategoriId','judul','catatan','namaFile','ukuran','bagian',
                                'rangkuman','kuis','aiModel','aiAt','aiStatus','aiPesan',
                                'dibuatOleh','createdAt'])
        && d.keys().hasAll(['kategoriId','judul','catatan','namaFile','ukuran','bagian',
                            'rangkuman','kuis','aiModel','aiAt','aiStatus','aiPesan',
                            'dibuatOleh','createdAt'])
        && d.kategoriId is string
        && d.kategoriId.size() >= 1
        && d.kategoriId.size() <= 80
        && d.judul is string
        && d.judul.size() >= 1
        && d.judul.size() <= 120
        && d.catatan is string
        && d.catatan.size() <= 300
        && d.namaFile is string
        && d.namaFile.size() <= 120
        && d.ukuran is number
        && d.ukuran >= 0
        && d.ukuran <= 7340032
        && d.bagian is number
        && d.bagian >= 0
        && d.bagian <= 20
        && d.rangkuman is string
        && d.rangkuman.size() <= 40000
        && d.kuis is list
        && d.kuis.size() <= 30
        && d.aiModel is string
        && d.aiModel.size() <= 60
        && d.aiAt is number
        && d.aiStatus in ['none','ok','error']
        && d.aiPesan is string
        && d.aiPesan.size() <= 300
        && d.dibuatOleh == 29
        && d.createdAt is number;
    }

    function isValidKisiBerkas(d) {
      return d.keys().hasOnly(['materiId','i','data','createdAt'])
        && d.keys().hasAll(['materiId','i','data','createdAt'])
        && d.materiId is string
        && d.materiId.size() >= 1
        && d.materiId.size() <= 80
        && d.i is number
        && d.i >= 0
        && d.i <= 20
        && d.data is string
        && d.data.size() >= 1
        && d.data.size() <= 750000
        && d.createdAt is number;
    }

    // ── ISLAND TYCOON (pulau pribadi, tanpa server/Blaze) ─────
    // Satu dokumen state per akun + subkoleksi objek. Pengunjung
    // boleh membaca, tapi setiap tulisan harus lolos validasi
    // bentuk dan tetap terikat ke nomor absen di path dokumen.
    match /islands/{absen} {
      allow read: if true;
      allow create, update: if absen.matches('^([1-9]|[1-5][0-9]|6[0-4])$')
        && isValidIslandDoc(request.resource.data);
      allow delete: if false;

      match /objects/{objectId} {
        allow read: if true;
        allow create, update: if absen.matches('^([1-9]|[1-5][0-9]|6[0-4])$')
          && isValidIslandObject(request.resource.data);
        allow delete: if resource.data.absen >= 1
          && resource.data.absen <= 64;
      }
    }

    // Escrow marketplace antar pemain.
    match /islandOffers/{offerId} {
      allow read: if true;
      allow create, update: if isValidIslandOffer(request.resource.data);
      allow delete: if true;
    }

    function isValidIslandDoc(d) {
      return d.keys().hasOnly(['absen','name','money','xp','level','inventory','needs',
                                'workers','vehicles','activeVehicle','stats','requests',
                                'createdAt','updatedAt','version'])
        && d.keys().hasAll(['absen','name','money','xp','level','inventory','needs',
                            'workers','vehicles','activeVehicle','stats','requests',
                            'createdAt','updatedAt','version'])
        && d.absen is number
        && d.absen >= 1
        && d.absen <= 64
        && d.name is string
        && d.name.size() >= 1
        && d.name.size() <= 30
        && d.money is number
        && d.money >= 0
        && d.money <= 1000000000
        && d.xp is number
        && d.xp >= 0
        && d.xp <= 10000000
        && d.level is number
        && d.level >= 1
        && d.level <= 10
        && d.inventory is map
        && d.inventory.size() <= 16
        && d.inventory.keys().hasOnly(['wood','stone','grain','corn','carrot','cotton',
                                        'plank','cement','flour','bread','juice','water',
                                        'bibit-gandum','bibit-jagung','bibit-wortel','bibit-kapas'])
        && isValidIslandNeeds(d.needs)
        && d.workers is list
        && d.workers.size() <= 8
        && d.vehicles is list
        && d.vehicles.size() <= 6
        && d.activeVehicle is string
        && d.activeVehicle.size() <= 40
        && isValidIslandStats(d.stats)
        && d.requests is list
        && d.requests.size() <= 12
        && d.createdAt is number
        && d.createdAt > 0
        && d.updatedAt is number
        && d.updatedAt > 0
        && d.version == 1;
    }

    function isValidIslandNeeds(n) {
      return n is map
        && n.keys().hasOnly(['hunger','thirst','updatedAt'])
        && n.keys().hasAll(['hunger','thirst','updatedAt'])
        && n.hunger is number
        && n.hunger >= 0
        && n.hunger <= 100
        && n.thirst is number
        && n.thirst >= 0
        && n.thirst <= 100
        && n.updatedAt is number
        && n.updatedAt > 0;
    }

    function isValidIslandStats(s) {
      return s is map
        && s.keys().hasOnly(['chopped','mined','harvested','built','collected','earned',
                              'spent','wagesPaid','wood','stone','woodWorker','marketSold',
                              'marketBought','offersMade','visits'])
        && s.keys().hasAll(['chopped','mined','harvested','built','collected','earned',
                            'spent','wagesPaid','wood','stone','woodWorker','marketSold',
                            'marketBought','offersMade','visits'])
        && s.chopped is number && s.chopped >= 0 && s.chopped <= 1000000000
        && s.mined is number && s.mined >= 0 && s.mined <= 1000000000
        && s.harvested is number && s.harvested >= 0 && s.harvested <= 1000000000
        && s.built is number && s.built >= 0 && s.built <= 1000000000
        && s.collected is number && s.collected >= 0 && s.collected <= 1000000000
        && s.earned is number && s.earned >= 0 && s.earned <= 1000000000
        && s.spent is number && s.spent >= 0 && s.spent <= 1000000000
        && s.wagesPaid is number && s.wagesPaid >= 0 && s.wagesPaid <= 1000000000
        && s.wood is number && s.wood >= 0 && s.wood <= 1000000000
        && s.stone is number && s.stone >= 0 && s.stone <= 1000000000
        && s.woodWorker is number && s.woodWorker >= 0 && s.woodWorker <= 1000000000
        && s.marketSold is number && s.marketSold >= 0 && s.marketSold <= 1000000000
        && s.marketBought is number && s.marketBought >= 0 && s.marketBought <= 1000000000
        && s.offersMade is number && s.offersMade >= 0 && s.offersMade <= 1000000000
        && s.visits is number && s.visits >= 0 && s.visits <= 1000000000;
    }

    function isValidIslandObject(d) {
      return d.keys().hasOnly(['absen','kind','type','x','y','rot','w','h','level','hp',
                                'respawnAt','crop','plantedAt','readyAt','batches',
                                'batchStartAt','auto','createdAt','updatedAt'])
        && d.keys().hasAll(['absen','kind','type','x','y','rot','w','h','level','hp',
                            'respawnAt','crop','plantedAt','readyAt','batches',
                            'batchStartAt','auto','createdAt','updatedAt'])
        && d.absen is number
        && d.absen >= 1
        && d.absen <= 64
        && d.kind in ['building','factory','plot','decor','natural']
        && d.type in ['rumah','gudang','pondok','plot','pabrik-kayu','pabrik-air',
                      'pabrik-pertanian','pabrik-semen','pabrik-makanan','bunga',
                      'batu-hias','bangku','pohon-hias','lampu','patung','pohon','batu']
        && d.x is number
        && d.x >= 2
        && d.x <= 38
        && d.y is number
        && d.y >= 2
        && d.y <= 38
        && d.rot is number
        && d.rot >= 0
        && d.rot <= 3
        && d.w is number
        && d.w >= 1
        && d.w <= 6
        && d.h is number
        && d.h >= 1
        && d.h <= 6
        && d.level is number
        && d.level >= 1
        && d.level <= 10
        && d.hp is number
        && d.hp >= 0
        && d.hp <= 10
        && d.respawnAt is number
        && d.respawnAt >= 0
        && d.respawnAt <= 10000000000000
        && d.crop is string
        && (d.crop == '' || d.crop in ['gandum','jagung','wortel','kapas'])
        && d.plantedAt is number
        && d.plantedAt >= 0
        && d.plantedAt <= 10000000000000
        && d.readyAt is number
        && d.readyAt >= 0
        && d.readyAt <= 10000000000000
        && d.batches is number
        && d.batches >= 0
        && d.batches <= 8
        && d.batchStartAt is number
        && d.batchStartAt >= 0
        && d.batchStartAt <= 10000000000000
        && d.auto is bool
        && d.createdAt is number
        && d.createdAt > 0
        && d.updatedAt is number
        && d.updatedAt > 0;
    }

    function isValidIslandOffer(d) {
      return d.keys().hasOnly(['sellerAbsen','sellerName','itemId','qty','price','createdAt','updatedAt'])
        && d.keys().hasAll(['sellerAbsen','sellerName','itemId','qty','price','createdAt','updatedAt'])
        && d.sellerAbsen is number
        && d.sellerAbsen >= 1
        && d.sellerAbsen <= 64
        && d.sellerName is string
        && d.sellerName.size() >= 1
        && d.sellerName.size() <= 30
        && d.itemId in ['wood','stone','grain','corn','carrot','cotton','plank','cement',
                        'flour','bread','juice','water','bibit-gandum','bibit-jagung',
                        'bibit-wortel','bibit-kapas']
        && d.qty is number
        && d.qty >= 1
        && d.qty <= 999
        && d.price is number
        && d.price >= 1
        && d.price <= 100000
        && d.createdAt is number
        && d.createdAt > 0
        && d.updatedAt is number
        && d.updatedAt > 0;
    }

    function isValidQuizConfig(d) {
      return d.keys().hasOnly(['subjects','diperbarui','editedBy'])
        && (!('subjects' in d) || d.subjects is list)
        && (!('diperbarui' in d) || d.diperbarui is number)
        && (!('editedBy' in d) || d.editedBy is string);
    }
  }
}
